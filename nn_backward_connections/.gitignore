# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.ipynb_checkpoints/

# Ephemeral scratch — exploratory diagnostics live here until PROMOTED to a track home
# (experiments/diagnostics/, src/mfas/randomgraph/, or a track .md). See experiments/roadmap.md.
# Keepers (e.g. the drift probes feeding Q01, the H35 under-relaxation evidence) must be promoted,
# not left here, so they stay reproducible-by-checkout.
dr_tmp/
# tmp/ is the port's staging area (payload tarball, one-off migration scripts). Untracked and
# unignored, it made every run record its git_commit as "<sha>+dirty", which the audit reads.
tmp/

# Project caches / large generated artifacts (rebuildable; see experiments/build_microns.py)
data/processed/
# In the Phase-7 sandbox these are symlinks into the original repo (48 GB of MICrONS source
# data + the built .npz) — never copied, never committed.
data/raw
# Keep the small MICrONS build documentation (recipe + stats JSON) — NOT the 55MB npz
!data/processed/microns_BUILD.md
!data/processed/microns_stats.json

# Per-run position vectors (large); the JSON records are kept in git.
results/*_positions.npy

# Keep the reference parity artifact (small, needed by the parity test).
!results/rocket_best_positions.npy

# Environments
.venv/
venv/
.env

# OS
.DS_Store

# Local Claude settings (contains CLAUDE_CODE_OAUTH_TOKEN — never commit)
.claude/settings.local.json

# Phase-7 campaign RUNTIME state (not research artifacts — those stay tracked:
# queue.json, killed.json, sota.json, state.json, lit/, DASHBOARD.md, audit_*.json)
autoresearch/logs/
autoresearch/.lock/
autoresearch/.budget
autoresearch/STOP

# Detached-sweep runtime state (autoresearch/sweep.sh + waitfor.sh): pid/plan/log scratch,
# recreated on every launch. Never part of the record — the record is results/*.json.
autoresearch/.sweep/
autoresearch/.lock/

# Champion orderings are TRACKED: the other machine must be able to evaluate them.
# int32 ranks, compressed, re-scored on pin. See tools/pin_champion.py.
!results/champions/
!results/champions/*.npz

# Watchdog scratch (runtime state, never committed)
autoresearch/ALERT
autoresearch/ALERTS.log
